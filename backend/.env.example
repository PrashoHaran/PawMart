PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string — see backend/README.md for how to get this
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pawmart?retryWrites=true&w=majority

# Any long random string — used to sign JWTs
JWT_SECRET=change-me-to-a-long-random-string

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:5173

# UTC offset appointment time slots are interpreted in (Sri Lanka = +05:30), so
# "09:00 AM" means the same moment wherever the server is hosted.
APP_UTC_OFFSET=+05:30

# Cloudinary image uploads (product images, pet photos). Find these on the
# Cloudinary dashboard. Leave empty to fall back to pasting image URLs.
CLOUDINARY_CLOUD_NAME=CLOUDINARY
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Sign in with Google (optional). OAuth "Web application" client ID from
# Google Cloud → Google Auth Platform → Clients. See GOOGLE_SETUP.md.
GOOGLE_CLIENT_ID=

# PayPal Checkout (sandbox = test money only). Create a free app at
# https://developer.paypal.com → Apps & Credentials → Sandbox, then paste its
# Client ID and Secret. Leave empty to hide PayPal at checkout.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Country code for checkout shipping addresses sent to PayPal (default LK)
PAYPAL_SHIPPING_COUNTRY=LK

# Email (Nodemailer). Leave SMTP_HOST empty in development to print emails to
# the console instead of sending them. For Gmail use smtp.gmail.com, port 587,
# and an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="PawMart <no-reply@pawmart.local>"

# Vaccination reminders: daily cron job (default 08:00 Asia/Colombo), emailing
# owners about vaccines due within REMINDER_DAYS_BEFORE days or overdue.
REMINDERS_ENABLED=true
REMINDER_CRON="0 8 * * *"
REMINDER_TZ=Asia/Colombo
REMINDER_DAYS_BEFORE=7
